# Copy to .env and edit locally. Never commit real values.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=-1001234567890
CWA_CONVERSATION_ID=REPLACE_WITH_EXISTING_CHAT_ID
CWA_AUTH_FILE=auth_data.json
# Comma-separated Telegram usernames of allowed peer bots (without @).
PEER_BOT_USERNAMES=FriendAgentBot
# Optional: leave blank to use CWA's defaults for that conversation.
CWA_MODEL=
CWA_REASONING_EFFORT=
MIN_INTERVAL_SECONDS=2
STATE_FILE=.agent-relay-state.json
