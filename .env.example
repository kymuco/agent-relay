# AgentRelay local settings. Copy to .env (never commit secrets).
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# One group only. Private messages are rejected even for allowed members.
TELEGRAM_CHAT_ID=-1001234567890
# Comma-separated numeric Telegram user IDs. No implicit access for other members.
ALLOWED_USER_IDS=123456789,987654321
# Existing chat ID from https://chatgpt.com/c/<id>
CWA_CONVERSATION_ID=YOUR_CHAT_CONVERSATION_ID
# Place raw authenticated /api/auth/session JSON in this path. No launcher required.
CWA_AUTH_FILE=auth_data.json
# Optional peer allowlist; both fields must be populated to accept another bot.
PEER_BOT_USERNAMES=
PEER_BOT_IDS=
CWA_MODEL=
CWA_REASONING_EFFORT=
MIN_INTERVAL_SECONDS=2
STATE_FILE=.agent-relay-state.json
# Durable /stop and /resume state, separate from Telegram cursor.
CONTROL_FILE=.agent-relay-control.json
# v0.2: read the last N allowed group messages only when answering (0 disables)
GROUP_CONTEXT_LIMIT=30
# Optional natural-language names for this bot, separate with commas
BOT_ALIASES=

# Optional two-bot Reply dialogue (on both PCs). No fixed turn count.
# Sessions stop after this many wall-clock seconds, /stoprelay, or model stop.
PEER_REPLY_MODE=off
PEER_REPLY_WINDOW_SECONDS=900

# v0.4: images, files, and voice. Enabled only for allowed users in the chosen group.
MEDIA_ENABLED=on
# off = only when addressed; on = automatically handle supported photos/voice/docs.
# Unsupported GIFs, MP4 and video are never auto-answered.
MEDIA_AUTO_REPLY=off
MAX_MEDIA_MB=10
# off = text only; on_voice = /voice or incoming voice -> voice only, /both -> both;
# always = text+voice by default, while explicit /voice overrides to voice only.
# Target the bot using @BotName /voice ... or /voice@BotName ... .
VOICE_REPLY_MODE=on_voice

# Smart Catch-up: combine historical Telegram updates after restart into <=1 reply.
# off = silently skip stale updates on restart. First launch also skips backlog.
CATCHUP_MODE=smart
CATCHUP_MAX_MESSAGES=100
CATCHUP_MAX_REPLIES=1
CATCHUP_MAX_AGE_MINUTES=180
