# AgentRelay local settings. Copy to .env (never commit secrets).
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# One group only. Private messages are rejected even for allowed members.
TELEGRAM_CHAT_ID=-1001234567890
# Comma-separated numeric Telegram user IDs. No implicit access for other members.
ALLOWED_USER_IDS=123456789,987654321
# Existing chat ID from https://chatgpt.com/c/<id>
CWA_CONVERSATION_ID=YOUR_CHAT_CONVERSATION_ID
# Place raw authenticated /api/auth/session JSON in this path. No launcher required.
CWA_AUTH_FILE=auth_data.json
# Optional peer allowlist; both fields must be populated to accept another bot.
PEER_BOT_USERNAMES=
PEER_BOT_IDS=
# Pinned for ALL ChatGPT conversations (main, catch-up, work coordinator, developer).
CWA_MODEL=gpt-6
CWA_REASONING_EFFORT=high
MIN_INTERVAL_SECONDS=2
STATE_FILE=.agent-relay-state.json
# Durable /stop and /resume state, separate from Telegram cursor.
CONTROL_FILE=.agent-relay-control.json
# v0.2: read the last N allowed group messages only when answering (0 disables)
GROUP_CONTEXT_LIMIT=30
# Optional natural-language names for this bot, separate with commas
BOT_ALIASES=

# Optional two-bot Reply dialogue (on both PCs). No fixed turn count.
# Sessions stop after this many wall-clock seconds, /stoprelay, or model stop.
PEER_REPLY_MODE=off
PEER_REPLY_WINDOW_SECONDS=900

# v0.4: images, files, and voice. Enabled only for allowed users in the chosen group.
MEDIA_ENABLED=on
# off = only when addressed; on = automatically handle supported photos/voice/docs.
# Unsupported GIFs, MP4 and video are never auto-answered.
MEDIA_AUTO_REPLY=off
MAX_MEDIA_MB=10
# off = text only; on_voice = /voice or incoming voice -> voice only, /both -> both;
# always = text+voice by default, while explicit /voice overrides to voice only.
# Target the bot using @BotName /voice ... or /voice@BotName ... .
VOICE_REPLY_MODE=on_voice

# Smart Catch-up: combine historical Telegram updates after restart into <=1 reply.
# off = silently skip stale updates on restart. First launch also skips backlog.
CATCHUP_MODE=smart
CATCHUP_MAX_MESSAGES=100
CATCHUP_MAX_REPLIES=1
CATCHUP_MAX_AGE_MINUTES=180

# Console: normal=lifecycle/errors, quiet=warnings/errors, debug=per-message.
LOG_LEVEL=normal
# Rotating diagnostics (no message text or credentials), or off for no file.
LOG_FILE=logs/agentrelay.log

# Local Codex Gateway: opt in only; choose a CLEAN sandbox checkout.
WORK_ENABLED=off
# Format: alias=absolute-dir;alias2=absolute-dir
# Example: demo=W:\dev\agentrelay-codex-sandbox
WORK_PROJECTS=
WORK_STATE_FILE=.agent-relay-work.json
WORK_TIMEOUT_SECONDS=600
WORK_MAX_ROUNDS=2
# Explicit owners of local writes (must be in ALLOWED_USER_IDS).
# Do NOT include your friend's ID unless you want them to run Codex on your PC.
WORK_ALLOWED_USER_IDS=

# Optional exact Python interpreter for Codex tests. If unset, the
# interpreter running AgentRelay is used (typically .venv\Scripts\python.exe).
# WORK_PYTHON=W:\dev\agent-relay\.venv\Scripts\python.exe

# In LOG_LEVEL=debug, each CWA chat request prints a start and finish
# with duration and purpose, but never the prompt/response or secrets.

# Local work backend. codex = legacy single-worker CLI; github = separate
# persistent GPT-6 High ChatGPT developer + coordinator, running in background.
# Requires a CLEAN, dedicated local checkout with origin matching WORK_REPOS.
WORK_EXECUTOR=codex
# Example: demo=kymuco/a-real-test-repository (use your actual repository).
WORK_REPOS=
WORK_CHAT_STATE_FILE=.agent-relay-work-chats.json
# Retired legacy checkout/Codex test path. Must remain off.
# Use WORK_LOCAL_TESTS with explicit Developer verification plans instead.
WORK_LOCAL_VERIFY=off
# Optional read-only GitHub Actions observation of the exact verified SHA.
WORK_CI_VERIFY=off
# Poll budget in seconds (0 = one snapshot; separate bounded HTTP timeouts).
WORK_CI_WAIT_SECONDS=60
# Optional restricted GitHub token (Actions: read on authorized repos). Keep private.
# WORK_CI_TOKEN=
# Optional existing dedicated absolute directory OUTSIDE all project checkouts.
# Nonempty enables materialization only for admitted local/hybrid plans.
# WORK_LOCAL_VERIFY must remain off.
WORK_WORKSPACE_ROOT=
# Opt-in per trusted project: e.g. demo=unittest;other=pytest.
# Runs repository code with your OS permissions; NOT an execution sandbox.
# No model-defined commands, no dependency installation. Local/hybrid plan only.
WORK_LOCAL_TESTS=
# Optional comma-separated subset of WORK_LOCAL_TESTS aliases.
# Allows Codex to process trusted source and a bounded failure excerpt.
# Read-only diagnosis, no repair; requires installed/authenticated Codex CLI.
WORK_CODEX_DIAGNOSTICS=
WORK_DIAGNOSTIC_TIMEOUT_SECONDS=180
# Opt-in automatic same-branch repairs after confirmed verification failures.
# Comma-separated configured GitHub project aliases; no numeric repair cap.
# Developer receives bounded failure evidence; GitHub Contents read required.
WORK_FEEDBACK_PROJECTS=

# Opt in to sharing metadata and immutable repository file links in this bot's group.
# Comma-separated configured GitHub aliases. Actions metadata also requires WORK_CI_VERIFY=on.
# No blob/archive downloads or local execution.
WORK_ARTIFACT_PROJECTS=

# Conservative natural-work routing. GitHub backend only; explicit human
# address, imperative and one allowlisted project are all required.
NATURAL_WORK_ENABLED=off

# Telegram native Rich Markdown for structured replies (opt-in).
# off uses existing HTML formatting, auto uses sendRichMessage for structured text.
TELEGRAM_RICH_MODE=off

# Image generation delivery: if MEDIA_ENABLED=on, generated image readback
# is retried read-only in a separate CWA client while Telegram chat remains free.
# Use /images@ragnacobot to recheck a previously requested image later.

# Telegram presentation (independent, no extra ChatGPT calls):
# 'typing...' during a live Ragna model response; refreshed at most every 4s.
CHAT_TYPING=off
# One editable status card for GitHub work; real stage transitions only.
# WORK_ENABLED=on and WORK_EXECUTOR=github are required when this is on.
WORK_LIVE_PROGRESS=off
WORK_PROGRESS_FILE=.agent-relay-progress.json

# Native Agency 0.1: off = legacy, observe = proposals only; no task execution.
# Enable observe ONLY in a dedicated test conversation/account with native
# connector writes disabled. Acknowledgement is not a permission check.
ACTION_MODE=off
ACTION_OBSERVE_READ_ONLY_ACK=off
ACTION_OBSERVATION_FILE=.agent-relay-action-observations.json

# NA-01.1: verify nonempty main-chat/catch-up responses by exact canonical IDs.
# Observe always verifies; off only permits provisional delivery in legacy mode.
CWA_VERIFY_FINAL_TEXT=on

# NA-02 dry-run: explicit comma-separated GitHub project aliases for automatic
# policy eligibility. Empty means writes would require additional permission.
# No proposal is executed in observe, even if allowed by policy.
ACTION_AUTO_PROJECTS=

# NA-03: execute is opt-in AFTER live observe/response-integrity checks.
# Keep ACTION_MODE=observe until verified. Execute requires a read-only main
# and coordinator context, explicit auto projects, WORK_EXECUTOR=github,
# WORK_ENABLED=on and WORK_LOCAL_VERIFY=off. Acknowledgements are operator
# statements, not technical verification of ChatGPT connector permissions.
ACTION_EXECUTE_ACK=off
ACTION_CLAIM_FILE=.agent-relay-action-claims.sqlite3
# Optional separate GitHub developer auth with only the required permissions.
# Keep credentials private; main/coordinator must not have native write access.
WORK_DEVELOPER_AUTH_FILE=

# NA-05: optional named agent profile. Leave blank for the existing legacy
# state paths. With a profile, state/log paths become profile-owned automatically.
# AGENTRELAY_ENV_FILE is an external shell variable selecting the config file.
AGENT_PROFILE=
AGENT_NAME=

# Native ChatGPT sandbox artifact receipts and verified Telegram delivery (opt-in).
# Requires MEDIA_ENABLED=on. No GitHub task or retained payload cache.
NATIVE_ARTIFACT_REGISTRY=off
